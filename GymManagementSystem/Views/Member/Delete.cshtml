@model DeleteMemberViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Member Confirmation</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-octagon-fill fs-3 me-3"></i>
                        <div>
                            <strong>Warning:</strong> Are you sure you want to delete this member?
                            <div class="small">This action is permanent and cannot be undone. Member data and attached records will be removed.</div>
                        </div>
                    </div>

                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body">
                            <div class="mb-2">
                                <small class="text-muted d-block">Member Name</small>
                                <span class="fw-bold fs-5 text-dark">@Model.Name</span>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted d-block">Email Address</small>
                                <span>@Model.Email</span>
                            </div>
                            <div>
                                <small class="text-muted d-block">Phone Number</small>
                                <span>@Model.Phone</span>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger flex-fill">
                                <i class="bi bi-trash me-1"></i>Yes, Delete Member
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
