@model CreateMemberViewModel

@{
    ViewData["Title"] = "Register Athlete";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="power-card overflow-hidden">
                <!-- Header -->
                <div class="p-4 p-md-5 border-bottom border-subtle">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-surface-2 border border-subtle text-power-accent d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-person-plus fs-4"></i>
                        </div>
                        <div>
                            <h1 class="h2 mb-1 fw-bold font-display text-white text-uppercase">Register Athlete</h1>
                            <p class="text-secondary mb-0 small">Create athlete profile and record biometric health baseline.</p>
                        </div>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-action="Create" method="post" id="createMemberForm" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="power-alert-danger p-3 mb-4" role="alert"></div>

                        <!-- Power Nav Pills -->
                        <ul class="nav power-nav-pills nav-fill mb-4" id="memberTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active font-display text-uppercase" id="member-info-tab" data-bs-toggle="tab" data-bs-target="#member-info" type="button" role="tab" aria-controls="member-info" aria-selected="true">
                                    1. Athlete Info
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link font-display text-uppercase" id="health-data-tab" data-bs-toggle="tab" data-bs-target="#health-data" type="button" role="tab" aria-controls="health-data" aria-selected="false">
                                    2. Biometric Data
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="memberTabContent">
                            <!-- Tab 1: Member Info -->
                            <div class="tab-pane fade show active" id="member-info" role="tabpanel" aria-labelledby="member-info-tab">
                                <h5 class="font-display fw-bold text-uppercase text-white mb-3">Identity & Contact</h5>

                                <div class="row g-3 mb-4">
                                    <div class="col-12 col-md-6">
                                        <label asp-for="Name" class="form-label">Full Name <span class="text-power-accent">*</span></label>
                                        <input asp-for="Name" class="form-control" placeholder="e.g. Omar Farooq" />
                                        <span asp-validation-for="Name" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="Email" class="form-label">Email Address <span class="text-power-accent">*</span></label>
                                        <input asp-for="Email" class="form-control" type="email" placeholder="e.g. omar@example.com" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="Phone" class="form-label">Phone Number <span class="text-power-accent">*</span></label>
                                        <input asp-for="Phone" class="form-control font-mono" placeholder="01012345678" />
                                        <span asp-validation-for="Phone" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label asp-for="DateOfBirth" class="form-label">Date of Birth <span class="text-power-accent">*</span></label>
                                        <input asp-for="DateOfBirth" class="form-control font-mono" type="date" />
                                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label asp-for="Gender" class="form-label">Gender <span class="text-power-accent">*</span></label>
                                        <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                            <option value="">Select Gender</option>
                                        </select>
                                        <span asp-validation-for="Gender" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Photo" class="form-label">Athlete Profile Photo</label>
                                        <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                                        <span asp-validation-for="Photo" class="text-danger small"></span>
                                        <small class="text-secondary d-block mt-1">Allowed: JPG, JPEG, PNG (max 5 MB)</small>
                                    </div>
                                </div>

                                <h5 class="font-display fw-bold text-uppercase text-white mb-3 pt-3 border-top border-subtle">Residential Address</h5>

                                <div class="row g-3 mb-4">
                                    <div class="col-12 col-md-3">
                                        <label asp-for="BuildingNumber" class="form-label">Building No. <span class="text-power-accent">*</span></label>
                                        <input asp-for="BuildingNumber" class="form-control font-mono" type="number" placeholder="12" />
                                        <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-5">
                                        <label asp-for="Street" class="form-label">Street <span class="text-power-accent">*</span></label>
                                        <input asp-for="Street" class="form-control" placeholder="El Tahrir St." />
                                        <span asp-validation-for="Street" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label asp-for="City" class="form-label">City <span class="text-power-accent">*</span></label>
                                        <input asp-for="City" class="form-control" placeholder="Cairo" />
                                        <span asp-validation-for="City" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button type="button" class="btn-power-primary" onclick="document.getElementById('health-data-tab').click();">
                                        Next: Biometrics &rarr;
                                    </button>
                                </div>
                            </div>

                            <!-- Tab 2: Health Data -->
                            <div class="tab-pane fade" id="health-data" role="tabpanel" aria-labelledby="health-data-tab">
                                <h5 class="font-display fw-bold text-uppercase text-white mb-3">Biometric & Clinical Data</h5>

                                <div class="row g-3 mb-4">
                                    <div class="col-12 col-md-4">
                                        <label asp-for="Height" class="form-label">Height (cm) <span class="text-power-accent">*</span></label>
                                        <input asp-for="Height" class="form-control font-mono" type="number" step="0.1" placeholder="175" />
                                        <span asp-validation-for="Height" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label asp-for="Weight" class="form-label">Weight (kg) <span class="text-power-accent">*</span></label>
                                        <input asp-for="Weight" class="form-control font-mono" type="number" step="0.1" placeholder="70" />
                                        <span asp-validation-for="Weight" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label asp-for="BloodType" class="form-label">Blood Type <span class="text-power-accent">*</span></label>
                                        <select asp-for="BloodType" class="form-select" asp-items="Html.GetEnumSelectList<BloodType>()">
                                            <option value="">Select Blood Type</option>
                                        </select>
                                        <span asp-validation-for="BloodType" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Note" class="form-label">Medical Conditions / Restrictions</label>
                                        <textarea asp-for="Note" class="form-control" rows="3" placeholder="Enter any cardiac conditions, joint injuries, allergies, or physical restrictions (optional)..."></textarea>
                                        <span asp-validation-for="Note" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between pt-4 border-top border-subtle">
                                    <button type="button" class="btn-power-ghost" onclick="document.getElementById('member-info-tab').click();">
                                        &larr; Back to Athlete Info
                                    </button>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Index" class="btn-power-ghost">Cancel</a>
                                        <button type="submit" class="btn-power-primary">
                                            <i class="bi bi-check-lg me-2"></i>
                                            Complete Registration
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
