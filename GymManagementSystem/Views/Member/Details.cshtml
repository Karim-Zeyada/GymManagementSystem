@model MemberDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Athlete Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="power-card overflow-hidden">
                <!-- Athlete Profile Header -->
                <div class="p-4 p-md-5 border-bottom border-subtle" style="background: linear-gradient(180deg, rgba(255, 85, 0, 0.08) 0%, rgba(20, 23, 31, 0.6) 100%);">
                    <div class="d-flex flex-column flex-sm-row align-items-center gap-4 text-center text-sm-start">
                        @if (!string.IsNullOrEmpty(Model.Photo))
                        {
                            var photoSrc = Model.Photo.StartsWith("http") || Model.Photo.StartsWith("/") ? Model.Photo : Url.Content($"~/images/members/{Model.Photo}");
                            <img src="@photoSrc" alt="@Model.Name" class="power-avatar-lg" />
                        }
                        else
                        {
                            <div class="power-avatar-placeholder-lg">
                                @Model.Name.FirstOrDefault()
                            </div>
                        }

                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-start gap-2 mb-2">
                                <h1 class="h2 mb-0 fw-bold font-display text-white text-uppercase">@Model.Name</h1>
                                <span class="power-badge-primary">Athlete #@Model.Id</span>
                            </div>

                            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-start gap-3 text-secondary small font-mono">
                                <span class="d-inline-flex align-items-center gap-1 text-white">
                                    <i class="bi bi-envelope-fill text-power-accent"></i>
                                    @Model.Email
                                </span>
                                <span class="d-inline-flex align-items-center gap-1 text-white">
                                    <i class="bi bi-telephone-fill text-power-accent"></i>
                                    @Model.Phone
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <!-- Personal Details -->
                    <h5 class="font-display fw-bold text-uppercase text-white mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill text-power-accent"></i>
                        Personal Information
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <div class="power-stat-box">
                                <small class="text-secondary d-block mb-1 text-uppercase font-display" style="color: #94A3B8 !important;">Gender</small>
                                <span class="fw-bold text-white fs-6">@Model.Gender</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="power-stat-box">
                                <small class="text-secondary d-block mb-1 text-uppercase font-display" style="color: #94A3B8 !important;">Date of Birth</small>
                                <span class="fw-bold text-white fs-6 font-mono">@Model.DateOfBirth.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="power-stat-box">
                                <small class="text-secondary d-block mb-1 text-uppercase font-display" style="color: #94A3B8 !important;">Residential Address</small>
                                <span class="fw-bold text-white fs-6 d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-geo-alt-fill text-power-accent me-1"></i>
                                    @Model.Address
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Membership & Subscription -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3 pt-3 border-top border-subtle">
                        <h5 class="font-display fw-bold text-uppercase text-white mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-card-checklist text-power-accent"></i>
                            Membership & Subscription
                        </h5>
                        <a asp-controller="MemberShip" asp-action="Create" asp-route-memberId="@Model.Id" class="btn-power-outline py-1 px-3 small text-white">
                            <i class="bi bi-plus-lg me-1 text-power-accent"></i>
                            Assign / Renew Plan
                        </a>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <div class="power-stat-box border-power-accent">
                                <small class="text-secondary d-block mb-1 text-uppercase font-display" style="color: #94A3B8 !important;">Active Tier</small>
                                <span class="fw-bold text-power-accent fs-5 font-display text-uppercase">@(Model.PlanName ?? "No Active Plan")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="power-stat-box">
                                <small class="text-secondary d-block mb-1 text-uppercase font-display" style="color: #94A3B8 !important;">Contract Start</small>
                                <span class="fw-bold text-white fs-6 font-mono">@(Model.MembershipStartDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="power-stat-box">
                                <small class="text-secondary d-block mb-1 text-uppercase font-display" style="color: #94A3B8 !important;">Contract Expiry</small>
                                <span class="fw-bold text-white fs-6 font-mono">@(Model.MembershipEndDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Health & Medical Details -->
                    @if (Model.HasHealthRecord)
                    {
                        <div class="power-card p-3 p-md-4 border-subtle d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3" style="background: rgba(239, 68, 68, 0.08); border-left: 4px solid var(--status-danger) !important;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 rounded-circle bg-surface-2 border border-subtle">
                                    <i class="bi bi-heart-pulse-fill text-danger fs-3"></i>
                                </div>
                                <div>
                                    <strong class="text-white d-block">Biometric Health Record Attached</strong>
                                    <span class="text-secondary small" style="color: #CBD5E1 !important;">Physical measurements, blood group, and medical restrictions recorded.</span>
                                </div>
                            </div>
                            <a asp-action="HealthRecord" asp-route-id="@Model.Id" class="btn-power-outline py-2 px-3 small text-nowrap text-white">
                                <i class="bi bi-eye-fill me-1 text-power-accent"></i>
                                View Biometrics
                            </a>
                        </div>
                    }
                </div>

                <!-- Footer Actions -->
                <div class="p-4 bg-surface-2 border-top border-subtle d-flex flex-column flex-sm-row justify-content-between gap-3">
                    <a asp-action="Index" class="btn-power-ghost text-white">
                        <i class="bi bi-arrow-left me-1"></i> Back to Directory
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-power-primary">
                            <i class="bi bi-pencil-fill me-2"></i>
                            Edit Athlete
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-power-danger">
                            <i class="bi bi-trash3-fill me-2"></i>
                            Delete Athlete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
