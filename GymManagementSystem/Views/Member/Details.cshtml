@model MemberDetailsViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-primary-color text-white p-4">
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Model.Photo))
                        {
                            var photoSrc = Model.Photo.StartsWith("http") || Model.Photo.StartsWith("/") ? Model.Photo : Url.Content($"~/images/members/{Model.Photo}");
                            <img src="@photoSrc" alt="@Model.Name" class="rounded-circle border border-2 border-white me-3" width="70" height="70" style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-white text-primary-color d-flex align-items-center justify-content-center fw-bold me-3" style="width:70px; height:70px; font-size:1.8rem;">
                                @Model.Name.FirstOrDefault()
                            </div>
                        }
                        <div>
                            <h3 class="mb-0 fw-bold">@Model.Name</h3>
                            <div class="opacity-75">
                                <i class="bi bi-envelope me-1"></i>@Model.Email &bull; <i class="bi bi-phone me-1"></i>@Model.Phone
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                        <i class="bi bi-person-lines-fill me-2"></i>Personal & Contact Details
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-gender-ambiguous me-1"></i>Gender</small>
                                <span class="fw-semibold">@Model.Gender</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-cake2 me-1"></i>Date of Birth</small>
                                <span class="fw-semibold">@Model.DateOfBirth.ToString("MMMM dd, yyyy")</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-geo-alt me-1"></i>Address</small>
                                <span class="fw-semibold">@Model.Address</span>
                            </div>
                        </div>
                    </div>

                    <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                        <i class="bi bi-card-checklist me-2"></i>Membership & Subscription
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-award me-1"></i>Current Plan</small>
                                <span class="fw-semibold text-primary-color">@(Model.PlanName ?? "No Active Plan")</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-calendar-event me-1"></i>Start Date</small>
                                <span class="fw-semibold">@(Model.MembershipStartDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-calendar-x me-1"></i>End Date</small>
                                <span class="fw-semibold">@(Model.MembershipEndDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                            </div>
                        </div>
                    </div>

                    @if (Model.HasHealthRecord)
                    {
                        <div class="p-3 bg-light border border-primary-subtle rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-heart-pulse-fill text-danger me-2 fs-4"></i>
                                <strong class="text-dark">Health Record Attached</strong>
                                <span class="text-muted ms-2 small">Physical metrics and medical record</span>
                            </div>
                            <a asp-action="HealthRecord" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-file-medical me-1"></i>View Health Record
                            </a>
                        </div>
                    }
                </div>

                <div class="card-footer bg-white border-top p-4 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-color text-white px-4">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
