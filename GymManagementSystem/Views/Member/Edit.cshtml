@model EditMemberViewModel

@{
    ViewData["Title"] = $"Update {Model.Name}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="power-card overflow-hidden">
                <!-- Header -->
                <div class="p-4 p-md-5 border-bottom border-subtle">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-surface-2 border border-subtle text-power-accent d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-pencil fs-4"></i>
                        </div>
                        <div>
                            <h1 class="h2 mb-1 fw-bold font-display text-white text-uppercase">Update Athlete</h1>
                            <p class="text-secondary mb-0 small">Update contact information, profile picture, or address.</p>
                        </div>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Photo" />
                        <div asp-validation-summary="ModelOnly" class="power-alert-danger p-3 mb-4" role="alert"></div>

                        <!-- Locked Identity Header -->
                        <div class="power-stat-box mb-4 d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(Model.Photo))
                            {
                                var photoSrc = Model.Photo.StartsWith("http") || Model.Photo.StartsWith("/") ? Model.Photo : Url.Content($"~/images/members/{Model.Photo}");
                                <img src="@photoSrc" alt="@Model.Name" class="power-avatar" />
                            }
                            else
                            {
                                <div class="power-avatar-placeholder">
                                    @Model.Name.FirstOrDefault()
                                </div>
                            }
                            <div>
                                <small class="text-secondary d-block font-display text-uppercase">Locked Legal Identity</small>
                                <span class="fw-bold text-white fs-5">@Model.Name</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PhotoFile" class="form-label">Change Profile Photo</label>
                            <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="PhotoFile" class="text-danger small"></span>
                            <small class="text-secondary d-block mt-1">Leave empty to retain existing photo. Allowed: JPG, JPEG, PNG (max 5 MB).</small>
                        </div>

                        <h5 class="font-display fw-bold text-uppercase text-white mb-3 pt-3 border-top border-subtle">Contact Details</h5>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-power-accent">*</span></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label">Phone Number <span class="text-power-accent">*</span></label>
                            <input asp-for="Phone" class="form-control font-mono" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <h5 class="font-display fw-bold text-uppercase text-white mb-3 pt-3 border-top border-subtle">Residential Address</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-4">
                                <label asp-for="BuildingNumber" class="form-label">Building No. <span class="text-power-accent">*</span></label>
                                <input asp-for="BuildingNumber" class="form-control font-mono" type="number" />
                                <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-8">
                                <label asp-for="Street" class="form-label">Street <span class="text-power-accent">*</span></label>
                                <input asp-for="Street" class="form-control" />
                                <span asp-validation-for="Street" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="City" class="form-label">City <span class="text-power-accent">*</span></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-4 border-top border-subtle">
                            <a asp-action="Index" class="btn-power-ghost">Cancel</a>
                            <button type="submit" class="btn-power-primary">
                                <i class="bi bi-check-lg me-2"></i>
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
