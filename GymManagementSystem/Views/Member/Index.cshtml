@model IEnumerable<MemberViewModel>

<div class="container-fluid mt-5 mb-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary-color mb-0 fw-bold">Members Directory</h2>
            <p class="text-muted">Manage active gym memberships and member accounts</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary-color text-white shadow-sm px-4">
                <i class="bi bi-person-plus-fill me-2"></i>Add Member
            </a>
        </div>
    </header>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Photo</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Gender</th>
                            <th>Phone</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(member.Photo))
                                    {
                                        var photoSrc = member.Photo.StartsWith("http") || member.Photo.StartsWith("/") ? member.Photo : Url.Content($"~/images/members/{member.Photo}");
                                        <img src="@photoSrc" alt="@member.Name" class="rounded-circle border" width="45" height="45" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-light text-primary-color d-flex align-items-center justify-content-center fw-bold border" style="width:45px; height:45px; font-size:1.1rem;">
                                            @member.Name.FirstOrDefault()
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@member.Name</div>
                                </td>
                                <td>
                                    <span class="text-muted">@member.Email</span>
                                </td>
                                <td>
                                    <span class="badge @(member.Gender == Gender.Male ? "bg-info text-dark" : "bg-danger-subtle text-danger")">
                                        @member.Gender
                                    </span>
                                </td>
                                <td>
                                    <span>@member.Phone</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@member.Id" class="btn btn-outline-secondary btn-sm" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@member.Id" class="btn btn-outline-primary btn-sm" title="Edit Member">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@member.Id" class="btn btn-outline-danger btn-sm" title="Delete Member">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-light rounded-3">
            <i class="bi bi-people display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Members Found</h4>
            <p class="text-muted">Get started by registering a new gym member.</p>
            <a asp-action="Create" class="btn btn-primary-color text-white px-4">
                <i class="bi bi-person-plus-fill me-1"></i>Add First Member
            </a>
        </div>
    }
</div>
