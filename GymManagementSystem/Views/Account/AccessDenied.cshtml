@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5 my-4">
    <div class="col-12 col-md-8 col-lg-5 text-center">
        <div class="power-card p-5">
            <div class="mb-4">
                <div class="d-inline-flex p-3 rounded-circle" style="background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3);">
                    <i class="bi bi-shield-x text-danger display-4"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-2 text-white font-display text-uppercase">ACCESS RESTRICTED</h2>
            <p class="text-secondary small mb-4 font-mono" style="line-height: 1.6;">
                You do not possess the required security role privileges to access this management module.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-power-outline px-4">
                    Return to Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-power-primary px-4">
                    Switch User
                </a>
            </div>
        </div>
    </div>
</div>
