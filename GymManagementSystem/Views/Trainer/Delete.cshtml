@model DeleteTrainerViewModel

@{
    ViewData["Title"] = $"Delete Coach - {Model.Name}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="power-card overflow-hidden" style="border-top: 4px solid var(--status-danger);">
                <!-- Header -->
                <div class="p-4 p-md-5 border-bottom border-subtle">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-surface-2 border border-subtle text-danger d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-trash3 fs-4"></i>
                        </div>
                        <div>
                            <span class="power-badge-danger mb-1">Destructive Action</span>
                            <h1 class="h3 mb-0 fw-bold font-display text-white text-uppercase">Delete Coach</h1>
                        </div>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <!-- Warning Banner -->
                    <div class="power-alert-danger p-3 mb-4 d-flex align-items-center gap-3">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-danger flex-shrink-0"></i>
                        <div class="small">
                            <strong>Permanent Deletion:</strong> Are you sure you want to delete this coach? Note: Coaches with active scheduled training sessions cannot be deleted.
                        </div>
                    </div>

                    <!-- Summary Box -->
                    <div class="power-stat-box mb-4">
                        <div class="mb-3">
                            <small class="text-secondary d-block font-display text-uppercase">Coach Name</small>
                            <span class="fw-bold fs-5 text-white">@Model.Name</span>
                        </div>
                        <div class="mb-2">
                            <small class="text-secondary d-block font-display text-uppercase">Speciality</small>
                            <span class="power-badge-primary">@Model.Speciality Coach</span>
                        </div>
                        <div>
                            <small class="text-secondary d-block font-display text-uppercase">Email</small>
                            <span class="text-secondary font-mono small">@Model.Email</span>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between gap-3">
                            <a asp-action="Index" class="btn-power-ghost flex-fill justify-content-center">Cancel</a>
                            <button type="submit" class="btn-power-danger flex-fill justify-content-center">
                                <i class="bi bi-trash3 me-2"></i>
                                Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
