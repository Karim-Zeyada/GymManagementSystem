@model EditTrainerViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary-color text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Update Trainer</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Locked Identity Header -->
                        <div class="p-3 bg-light rounded-3 mb-4 border">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-lock-fill text-muted me-2"></i>
                                <span class="text-muted small fw-semibold">Editing Profile For (Locked Fields)</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-12">
                                    <span class="fw-bold fs-5 text-dark">@Model.Name</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">DOB:</small> <span class="small fw-semibold">@Model.DateOfBirth.ToString("yyyy-MM-dd")</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Gender:</small> <span class="small fw-semibold">@Model.Gender</span>
                                </div>
                            </div>
                        </div>

                        <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                            <i class="bi bi-telephone me-2"></i>Contact Information
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                            <i class="bi bi-geo-alt me-2"></i>Address Information
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="BuildingNumber" class="form-label fw-semibold">Building No. <span class="text-danger">*</span></label>
                                <input asp-for="BuildingNumber" class="form-control" type="number" />
                                <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Street" class="form-label fw-semibold">Street <span class="text-danger">*</span></label>
                                <input asp-for="Street" class="form-control" />
                                <span asp-validation-for="Street" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="City" class="form-label fw-semibold">City <span class="text-danger">*</span></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                            <i class="bi bi-award me-2"></i>Professional Specialization
                        </h5>

                        <div class="mb-4">
                            <label asp-for="Speciality" class="form-label fw-semibold">Specialty <span class="text-danger">*</span></label>
                            <select asp-for="Speciality" class="form-select" asp-items="Html.GetEnumSelectList<Speciality>()"></select>
                            <span asp-validation-for="Speciality" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-color text-white px-4">
                                <i class="bi bi-check-circle me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
