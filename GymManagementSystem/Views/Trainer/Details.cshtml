@model TrainerDetailsViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-primary-color text-white p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-white text-primary-color d-flex align-items-center justify-content-center fw-bold me-3" style="width:70px; height:70px; font-size:1.8rem;">
                                @Model.Name.FirstOrDefault()
                            </div>
                            <div>
                                <h3 class="mb-1 fw-bold">@Model.Name</h3>
                                <span class="badge bg-white text-primary fw-bold px-3 py-2">
                                    <i class="bi bi-award me-1"></i>@Model.SpecializationLabel
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                        <i class="bi bi-person-lines-fill me-2"></i>Contact & Personal Details
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-envelope me-1"></i>Email Address</small>
                                <span class="fw-semibold text-dark">@Model.Email</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-phone me-1"></i>Phone Number</small>
                                <span class="fw-semibold text-dark">@Model.Phone</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-cake2 me-1"></i>Date of Birth</small>
                                <span class="fw-semibold text-dark">@Model.DateOfBirth.ToString("MMMM dd, yyyy")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-award me-1"></i>Specialty</small>
                                <span class="fw-semibold text-primary">@Model.Speciality</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block mb-1"><i class="bi bi-geo-alt me-1"></i>Residential Address</small>
                                <span class="fw-semibold text-dark">@Model.Address</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-top p-4 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-color text-white px-4">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
