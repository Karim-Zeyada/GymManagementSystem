@model IEnumerable<TrainerViewModel>

@{
    ViewData["Title"] = "Coaches & Trainers";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom border-subtle">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-person-workspace text-power-accent fs-3"></i>
                <h1 class="h2 mb-0 fw-bold font-display text-uppercase tracking-wide text-white">Coaches Directory</h1>
            </div>
            <p class="text-secondary mb-0 small" style="color: #CBD5E1 !important;">Manage certified personal trainers, strength coaches, and session instructors.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn-power-primary">
                <i class="bi bi-person-plus-fill me-2 fs-6"></i>
                Add Coach
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="power-table-wrapper">
            <div class="table-responsive">
                <table class="table power-table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Coach</th>
                            <th>Email Address</th>
                            <th>Phone</th>
                            <th>Specialization</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trainer in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="power-avatar-placeholder">
                                            @trainer.Name.FirstOrDefault()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white fs-6">@trainer.Name</div>
                                            <small class="text-muted font-mono" style="color: #94A3B8 !important;">Coach #@trainer.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-mono small" style="color: #E2E8F0 !important;">@trainer.Email</span>
                                </td>
                                <td>
                                    <span class="font-mono small" style="color: #CBD5E1 !important;">@trainer.Phone</span>
                                </td>
                                <td>
                                    <span class="power-badge-primary">
                                        <i class="bi bi-fire me-1 text-power-accent"></i>
                                        @trainer.SpecializationName
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@trainer.Id" class="btn-action-view" title="View Coach Profile">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@trainer.Id" class="btn-action-edit" title="Edit Coach">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@trainer.Id" class="btn-action-delete" title="Delete Coach">
                                            <i class="bi bi-trash3-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="power-card text-center py-5 px-4 my-4">
            <div class="d-inline-flex p-4 rounded-circle bg-surface-2 mb-3 border border-subtle">
                <i class="bi bi-person-workspace text-secondary display-4 opacity-50"></i>
            </div>
            <h3 class="font-display fw-bold text-white text-uppercase">No Coaches Registered</h3>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 440px; color: #CBD5E1 !important;">Get started by onboarding a qualified strength coach or fitness specialist.</p>
            <a asp-action="Create" class="btn-power-primary">
                <i class="bi bi-person-plus-fill me-2 fs-6"></i>
                Add First Coach
            </a>
        </div>
    }
</div>
