@model IEnumerable<TrainerViewModel>

<div class="container-fluid mt-5 mb-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary-color mb-0 fw-bold">Trainers Directory</h2>
            <p class="text-muted">Manage fitness coaches, instructors, and specialists</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary-color text-white shadow-sm px-4">
                <i class="bi bi-person-plus-fill me-2"></i>Add Trainer
            </a>
        </div>
    </header>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Specialization</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trainer in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light text-primary-color d-flex align-items-center justify-content-center fw-bold me-3 border" style="width:40px; height:40px;">
                                            @trainer.Name.FirstOrDefault()
                                        </div>
                                        <span class="fw-bold text-dark">@trainer.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@trainer.Email</span>
                                </td>
                                <td>
                                    <span>@trainer.Phone</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                                        <i class="bi bi-award me-1"></i>@trainer.SpecializationName
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@trainer.Id" class="btn btn-outline-secondary btn-sm" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@trainer.Id" class="btn btn-outline-primary btn-sm" title="Edit Trainer">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@trainer.Id" class="btn btn-outline-danger btn-sm" title="Delete Trainer">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-light rounded-3">
            <i class="bi bi-person-workspace display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Trainers Found</h4>
            <p class="text-muted">Get started by adding a professional gym trainer.</p>
            <a asp-action="Create" class="btn btn-primary-color text-white px-4">
                <i class="bi bi-person-plus-fill me-1"></i>Add First Trainer
            </a>
        </div>
    }
</div>
