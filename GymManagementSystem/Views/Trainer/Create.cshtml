@model CreateTrainerViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary-color text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Add New Trainer</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Section 1: Personal Information -->
                        <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                            <i class="bi bi-person me-2"></i>Personal Information
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Captain Karim" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="e.g. trainer@gym.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                                <input asp-for="Phone" class="form-control" placeholder="01012345678" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="DateOfBirth" class="form-label fw-semibold">Date of Birth <span class="text-danger">*</span></label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Gender" class="form-label fw-semibold">Gender <span class="text-danger">*</span></label>
                                <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                    <option value="">Select Gender</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Section 2: Address Information -->
                        <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                            <i class="bi bi-geo-alt me-2"></i>Address Information
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label asp-for="BuildingNumber" class="form-label fw-semibold">Building No. <span class="text-danger">*</span></label>
                                <input asp-for="BuildingNumber" class="form-control" type="number" placeholder="5" />
                                <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Street" class="form-label fw-semibold">Street <span class="text-danger">*</span></label>
                                <input asp-for="Street" class="form-control" placeholder="Fitness Road" />
                                <span asp-validation-for="Street" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-semibold">City <span class="text-danger">*</span></label>
                                <input asp-for="City" class="form-control" placeholder="Alexandria" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Section 3: Professional Information -->
                        <h5 class="text-primary-color mb-3 pb-2 border-bottom">
                            <i class="bi bi-briefcase me-2"></i>Professional Information
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Speciality" class="form-label fw-semibold">Speciality <span class="text-danger">*</span></label>
                                <select asp-for="Speciality" class="form-select" asp-items="Html.GetEnumSelectList<Speciality>()">
                                    <option value="">Select Speciality</option>
                                </select>
                                <span asp-validation-for="Speciality" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-color text-white px-4">
                                <i class="bi bi-check-circle me-1"></i>Submit Trainer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
