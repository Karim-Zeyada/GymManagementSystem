@model IEnumerable<PlanViewModel>

@{
    ViewData["Title"] = "Membership Plans";
}

<div class="container-fluid py-4">
    <header class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-card-checklist text-power-accent fs-4"></i>
                <span class="text-power-accent font-display text-uppercase fw-bold" style="letter-spacing: 1px;">MEMBERSHIP TIERS</span>
            </div>
            <h1 class="display-5 text-white mb-0 fw-bold font-display text-uppercase">ATHLETIC PLANS & PRICING</h1>
            <p class="text-secondary" style="color: #CBD5E1 !important;">Select an elite gym membership package engineered for your fitness goals</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div>
                <a asp-action="Create" class="btn btn-power-primary px-4 shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i>
                    Create New Plan
                </a>
            </div>
        }
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4 justify-content-center">
            @foreach (var plan in Model)
            {
                var isHighlighted = plan.DurationDays >= 90;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="power-card power-card-interactive h-100 d-flex flex-column overflow-hidden position-relative @(isHighlighted ? "border-power-accent" : "")" style="@(isHighlighted ? "box-shadow: 0 0 28px rgba(255,85,0,0.25);" : "")">
                        @if (isHighlighted)
                        {
                            <div class="position-absolute top-0 end-0 bg-power-accent text-white px-3 py-1 font-mono fw-bold" style="font-size: 0.7rem; border-bottom-left-radius: 10px; letter-spacing: 1px;">
                                MOST POPULAR
                            </div>
                        }

                        <div class="p-4 border-bottom border-secondary border-opacity-25 bg-black bg-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge @(plan.IsActive ? "power-badge-active" : "power-badge-expired") font-mono" style="font-size: 0.7rem;">
                                    <span class="power-pip @(plan.IsActive ? "power-pip-success" : "power-pip-expired")"></span>
                                    @(plan.IsActive ? "ACTIVE TIER" : "ARCHIVED")
                                </span>
                            </div>
                            <h3 class="fw-bold text-white font-display text-uppercase mb-0">@plan.Name</h3>
                        </div>

                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="text-center my-3">
                                <span class="display-4 fw-bold text-white font-mono">$@plan.Price.ToString("N2")</span>
                                <div class="text-secondary small font-mono mt-1" style="color: #CBD5E1 !important;">/ @plan.DurationDays Days Full Access</div>
                            </div>

                            <p class="text-secondary small mb-4 text-center" style="min-height: 40px; color: #CBD5E1 !important;">
                                @plan.Description
                            </p>

                            <!-- Perks list -->
                            <div class="d-flex flex-column gap-2 mb-4">
                                <div class="d-flex align-items-center gap-2 small text-light">
                                    <i class="bi bi-check-circle-fill text-success fs-6"></i>
                                    <span>Full gym floor & Olympic lifting access</span>
                                </div>
                                <div class="d-flex align-items-center gap-2 small text-light">
                                    <i class="bi bi-check-circle-fill text-success fs-6"></i>
                                    <span>Coached sessions schedule reservation</span>
                                </div>
                                <div class="d-flex align-items-center gap-2 small text-light">
                                    <i class="bi bi-check-circle-fill text-success fs-6"></i>
                                    <span>Biometric health records profile</span>
                                </div>
                            </div>

                            <div class="mt-auto d-flex flex-column gap-2">
                                <a asp-controller="Plans" asp-action="Details" asp-route-id="@plan.Id" class="btn btn-power-outline w-100 justify-content-center text-white">
                                    View Full Details
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Plans" asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-action-edit flex-fill" title="Edit Plan">
                                            <i class="bi bi-pencil-fill me-1"></i> Edit
                                        </a>
                                        <form asp-controller="Plans" asp-action="Activate" asp-route-id="@plan.Id" method="post" class="flex-fill">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm w-100 @(plan.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(plan.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="power-card text-center py-5 my-4">
            <i class="bi bi-card-checklist text-secondary display-4 opacity-50 mb-3 d-block"></i>
            <h4 class="text-white font-display text-uppercase">No Membership Plans Configured</h4>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-power-primary mt-3">Create First Plan</a>
            }
        </div>
    }
</div>
