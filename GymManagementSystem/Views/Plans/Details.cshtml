@model PlanDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} Details";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="power-card overflow-hidden">
            <div class="p-4 p-md-5 text-center position-relative border-bottom border-secondary border-opacity-25" style="background: radial-gradient(circle at top, rgba(255,85,0,0.2) 0%, rgba(17,19,27,0.9) 70%);">
                <div class="d-inline-flex p-3 rounded-circle bg-black bg-opacity-40 border border-secondary border-opacity-25 mb-3 text-power-accent align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-tag fs-2"></i>
                </div>
                <h1 class="display-6 fw-bold text-white font-display text-uppercase mb-2">@Model.Name</h1>
                <span class="badge @(Model.IsActive ? "power-badge-active" : "power-badge-expired") font-mono">
                    <span class="power-pip @(Model.IsActive ? "power-pip-success" : "power-pip-expired")"></span>
                    @(Model.IsActive ? "ACTIVE TIER" : "ARCHIVED")
                </span>
            </div>

            <div class="p-4 p-md-5">
                <div class="text-center py-4 px-3 power-card mb-4" style="background-color: var(--bg-surface-2);">
                    <div class="display-3 fw-bold text-white font-mono">@Model.Price.ToString("N0")</div>
                    <span class="text-power-accent font-display fs-5 fw-bold">EGP</span>
                    <span class="text-secondary small font-mono">&bull; @Model.DurationDays Days Full Access</span>
                </div>

                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="p-3 power-card" style="background-color: var(--bg-surface-2);">
                        <div class="text-secondary small font-display text-uppercase mb-1">
                            <i class="bi bi-calendar-event me-1 text-power-accent"></i>
                            Duration
                        </div>
                        <div class="fw-bold text-white font-mono fs-5">@Model.DurationDays Days</div>
                    </div>

                    <div class="p-3 power-card" style="background-color: var(--bg-surface-2);">
                        <div class="text-secondary small font-display text-uppercase mb-1">
                            <i class="bi bi-card-text me-1 text-power-accent"></i>
                            Package Description & Perks
                        </div>
                        <p class="text-light mb-0" style="line-height: 1.6;">@Model.Description</p>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Index" class="btn btn-power-outline px-4">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Plans
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-power-primary px-4">
                            <i class="bi bi-pencil me-1"></i>
                            Edit Plan
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
