@model CreateMembershipViewModel

@{
    ViewData["Title"] = "Assign Membership";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="power-card overflow-hidden">
            <div class="p-4 bg-black bg-opacity-30 border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 rounded-circle bg-black bg-opacity-40 border border-secondary border-opacity-25 text-power-accent d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="bi bi-credit-card fs-5"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-white font-display text-uppercase mb-0">Assign Membership</h3>
                        <span class="text-secondary small">Enroll an athlete in an active gym package</span>
                    </div>
                </div>
            </div>

            <div class="p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert power-alert-danger mb-4" role="alert"></div>

                    <!-- Member Selection -->
                    <div class="mb-4">
                        <label asp-for="MemberId" class="form-label font-display text-uppercase">
                            <i class="bi bi-person me-1 text-power-accent"></i>
                            Select Athlete <span class="text-power-accent">*</span>
                        </label>
                        <select asp-for="MemberId" asp-items="Model.Members" class="form-select form-select-lg font-mono">
                            <option value="">-- Choose Athlete --</option>
                        </select>
                        <span asp-validation-for="MemberId" class="text-danger small"></span>
                    </div>

                    <!-- Plan Selection -->
                    <div class="mb-4">
                        <label asp-for="PlanId" class="form-label font-display text-uppercase">
                            <i class="bi bi-layers me-1 text-power-accent"></i>
                            Select Gym Package <span class="text-power-accent">*</span>
                        </label>
                        <select asp-for="PlanId" asp-items="Model.Plans" class="form-select form-select-lg font-mono">
                            <option value="">-- Choose Package --</option>
                        </select>
                        <span asp-validation-for="PlanId" class="text-danger small"></span>
                        <div class="text-secondary small mt-1 font-mono">Duration and expiration date are automatically computed from the selected plan.</div>
                    </div>

                    <!-- Start Date -->
                    <div class="mb-4">
                        <label asp-for="StartDate" class="form-label font-display text-uppercase">
                            <i class="bi bi-calendar-event me-1 text-power-accent"></i>
                            Membership Start Date <span class="text-power-accent">*</span>
                        </label>
                        <input asp-for="StartDate" type="date" class="form-control form-control-lg font-mono" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="power-card p-3 mb-4" style="background-color: var(--bg-surface-2);">
                        <div class="d-flex align-items-center gap-2 text-secondary small font-mono">
                            <i class="bi bi-shield-check text-power-accent fs-6"></i>
                            <span>System Rule: Athletes cannot hold overlapping active memberships simultaneously.</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25 mt-4">
                        <a asp-action="Index" class="btn btn-power-outline px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-power-primary px-4">
                            Confirm Subscription
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
