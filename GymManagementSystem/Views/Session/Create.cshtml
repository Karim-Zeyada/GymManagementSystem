@model CreateSessionViewModel

@{
    ViewData["Title"] = "Schedule New Session";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="power-card overflow-hidden">
                <!-- Header -->
                <div class="p-4 p-md-5 border-bottom border-subtle">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-surface-2 border border-subtle text-power-accent d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-calendar-plus fs-4"></i>
                        </div>
                        <div>
                            <h1 class="h2 mb-1 fw-bold font-display text-white text-uppercase">Schedule Training Session</h1>
                            <p class="text-secondary mb-0 small">Define workout discipline, assign coach, set roster capacity, and set timetable.</p>
                        </div>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="power-alert-danger p-3 mb-4" role="alert"></div>

                        <!-- Section 1: Session Information -->
                        <h5 class="font-display fw-bold text-uppercase text-white mb-3">Discipline & Assignment</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="CategoryId" class="form-label">Category <span class="text-power-accent">*</span></label>
                                <select asp-for="CategoryId" asp-items="@(ViewBag.Categories ?? Model.Categories)" class="form-select">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="TrainerId" class="form-label">Assigned Coach <span class="text-power-accent">*</span></label>
                                <select asp-for="TrainerId" asp-items="@(ViewBag.Trainers ?? Model.Trainers)" class="form-select">
                                    <option value="">-- Select Coach --</option>
                                </select>
                                <span asp-validation-for="TrainerId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Capacity" class="form-label">Max Capacity <span class="text-power-accent">*</span></label>
                                <input asp-for="Capacity" type="number" min="1" max="500" class="form-control font-mono" placeholder="e.g. 15" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Session Description <span class="text-power-accent">*</span></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Specify workout targets, required gear, or athletic intensity..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Section 2: Date & Time -->
                        <h5 class="font-display fw-bold text-uppercase text-white mb-3 pt-3 border-top border-subtle">Timetable & Duration</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="StartDate" class="form-label">Start Date & Time <span class="text-power-accent">*</span></label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control font-mono" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="EndDate" class="form-label">End Date & Time <span class="text-power-accent">*</span></label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control font-mono" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-4 border-top border-subtle">
                            <a asp-action="Index" class="btn-power-ghost">Cancel</a>
                            <button type="submit" class="btn-power-primary">
                                <i class="bi bi-check-lg me-2"></i>
                                Schedule Session
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
