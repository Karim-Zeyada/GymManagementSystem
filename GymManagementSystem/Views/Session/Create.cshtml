@model CreateSessionViewModel

@{
    ViewData["Title"] = "Create New Session";
}

<div class="row justify-content-center my-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="bi bi-calendar-plus fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">Create New Session</h3>
                        <p class="text-muted mb-0">Schedule a new training session for gym members.</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                    <!-- Section 1: Session Information -->
                    <div class="p-3 mb-4 rounded-3 border bg-light bg-opacity-50">
                        <h5 class="fw-bold text-primary mb-3">
                            <i class="bi bi-info-circle me-2"></i>Session Information
                        </h5>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold">
                                    Category <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CategoryId" asp-items="@(ViewBag.Categories ?? Model.Categories)" class="form-select">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="TrainerId" class="form-label fw-semibold">
                                    Trainer <span class="text-danger">*</span>
                                </label>
                                <select asp-for="TrainerId" asp-items="@(ViewBag.Trainers ?? Model.Trainers)" class="form-select">
                                    <option value="">-- Select Trainer --</option>
                                </select>
                                <span asp-validation-for="TrainerId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Capacity" class="form-label fw-semibold">
                                    Capacity (Max Participants) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Capacity" type="number" min="1" max="500" class="form-control" placeholder="e.g. 15" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Description <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter session goals, equipment needed, or workout intensity..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Date & Time -->
                    <div class="p-3 mb-4 rounded-3 border bg-light bg-opacity-50">
                        <h5 class="fw-bold text-primary mb-3">
                            <i class="bi bi-clock-history me-2"></i>Date & Time
                        </h5>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">
                                    Start Date & Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold">
                                    End Date & Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">
                            <i class="bi bi-info-circle me-1"></i>Duration will be calculated automatically from the selected time window.
                        </small>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Create Session
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
