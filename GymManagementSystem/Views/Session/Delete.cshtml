@model DeleteSessionViewModel

@{
    ViewData["Title"] = $"Delete Session #{Model.Id}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">
            <div class="power-card overflow-hidden" style="border-top: 4px solid var(--status-danger);">
                <!-- Header -->
                <div class="p-4 p-md-5 border-bottom border-subtle">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-surface-2 border border-subtle text-danger d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-trash3 fs-4"></i>
                        </div>
                        <div>
                            <span class="power-badge-danger mb-1">Destructive Action</span>
                            <h1 class="h3 mb-0 fw-bold font-display text-white text-uppercase">Delete Session #@Model.Id</h1>
                        </div>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <!-- Warning Banner -->
                    <div class="power-alert-danger p-3 mb-4 d-flex align-items-center gap-3">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-danger flex-shrink-0"></i>
                        <div class="small">
                            <strong>Permanent Deletion:</strong> Removing this session will permanently cancel and erase all <strong>@Model.BookedSlots active member booking(s)</strong>.
                        </div>
                    </div>

                    <!-- Summary Box -->
                    <div class="power-stat-box mb-4">
                        <div class="row g-2 font-mono small">
                            <div class="col-sm-4 text-secondary text-uppercase font-display">Discipline:</div>
                            <div class="col-sm-8 fw-semibold text-white">@Model.CategoryName</div>

                            <div class="col-sm-4 text-secondary text-uppercase font-display">Coach:</div>
                            <div class="col-sm-8 fw-semibold text-white">@Model.TrainerName</div>

                            <div class="col-sm-4 text-secondary text-uppercase font-display">Start Time:</div>
                            <div class="col-sm-8 fw-semibold text-white">@Model.StartDate.ToString("f")</div>

                            <div class="col-sm-4 text-secondary text-uppercase font-display">End Time:</div>
                            <div class="col-sm-8 fw-semibold text-white">@Model.EndDate.ToString("f")</div>

                            <div class="col-sm-4 text-secondary text-uppercase font-display">Active Bookings:</div>
                            <div class="col-sm-8">
                                <span class="power-badge-primary">@Model.BookedSlots Enrolled</span>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between gap-3">
                            <a asp-action="Index" class="btn-power-ghost flex-fill justify-content-center">Cancel</a>
                            <button type="submit" class="btn-power-danger flex-fill justify-content-center">
                                <i class="bi bi-trash3 me-2"></i>
                                Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
