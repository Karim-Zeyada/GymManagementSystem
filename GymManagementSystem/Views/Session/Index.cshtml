@model IEnumerable<SessionViewModel>

@{
    ViewData["Title"] = "Training Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar3-event me-2 text-primary-color"></i>Training Sessions</h2>
        <p class="text-muted mb-0">Browse, manage, and schedule gym workout sessions.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
        <i class="bi bi-plus-circle-fill"></i>
        <span>Add New Session</span>
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5 shadow-sm rounded-4" role="alert">
        <i class="bi bi-info-circle display-4 d-block mb-3 text-primary"></i>
        <h5 class="fw-bold">No Training Sessions Found</h5>
        <p class="text-muted mb-3">No sessions have been scheduled yet. Get started by creating your first session.</p>
        <a asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-plus-circle me-1"></i>Create Session
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var session in Model)
        {
            var headerBg = session.Status switch
            {
                SessionStatus.Upcoming => "background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);",
                SessionStatus.Ongoing => "background: linear-gradient(135deg, #065f46 0%, #10b981 100%);",
                SessionStatus.Completed => "background: linear-gradient(135deg, #4b5563 0%, #9ca3af 100%);",
                _ => "background: #6c757d;"
            };

            var badgeText = session.Status switch
            {
                SessionStatus.Upcoming => "🔵 Upcoming",
                SessionStatus.Ongoing => "🟢 Ongoing",
                SessionStatus.Completed => "⚪ Completed",
                _ => "Status"
            };

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden d-flex flex-column">
                    <!-- Header with Status-driven colour -->
                    <div class="card-header text-white p-3 d-flex justify-content-between align-items-center" style="@headerBg">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-lightning-charge-fill fs-5"></i>
                            <h5 class="fw-bold mb-0 text-white">@session.CategoryName</h5>
                        </div>
                        <span class="badge bg-light text-dark fw-bold px-2 py-1 rounded-pill">
                            @badgeText
                        </span>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <p class="card-text text-muted small mb-3 text-truncate" title="@session.Description">
                            @session.Description
                        </p>

                        <ul class="list-unstyled mb-3 small d-flex flex-column gap-2 flex-grow-1">
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-badge text-primary fs-6"></i>
                                <span class="text-muted">Trainer:</span>
                                <strong class="ms-auto text-black-alternative">@session.TrainerName</strong>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-calendar-event text-secondary fs-6"></i>
                                <span class="text-muted">Date:</span>
                                <strong class="ms-auto text-black-alternative">@session.StartDate.ToString("MMM dd, yyyy")</strong>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-clock text-info fs-6"></i>
                                <span class="text-muted">Time:</span>
                                <strong class="ms-auto text-black-alternative">@session.TimeString</strong>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-stopwatch text-warning fs-6"></i>
                                <span class="text-muted">Duration:</span>
                                <strong class="ms-auto text-black-alternative">@session.DurationString</strong>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-people text-success fs-6"></i>
                                <span class="text-muted">Capacity:</span>
                                <span class="badge bg-light text-dark border ms-auto">
                                    @session.CapacityString
                                </span>
                            </li>
                        </ul>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 pt-2 border-top">
                            <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-sm btn-outline-info flex-grow-1 d-flex align-items-center justify-content-center gap-1" title="View Details">
                                <i class="bi bi-eye"></i> Details
                            </a>

                            @if (session.Status == SessionStatus.Upcoming)
                            {
                                <a asp-action="Edit" asp-route-id="@session.Id" class="btn btn-sm btn-outline-warning flex-grow-1 d-flex align-items-center justify-content-center gap-1" title="Edit Session">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary flex-grow-1" disabled title="Only upcoming sessions can be edited">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                            }

                            @if (session.Status != SessionStatus.Ongoing)
                            {
                                <a asp-action="Delete" asp-route-id="@session.Id" class="btn btn-sm btn-outline-danger flex-grow-1 d-flex align-items-center justify-content-center gap-1" title="Delete Session">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary flex-grow-1" disabled title="Ongoing sessions cannot be deleted">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
