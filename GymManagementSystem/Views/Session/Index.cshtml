@model IEnumerable<SessionViewModel>

@{
    ViewData["Title"] = "Training Schedule";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom border-subtle">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-calendar3 text-power-accent fs-3"></i>
                <h1 class="h2 mb-0 fw-bold font-display text-uppercase tracking-wide text-white">Training Schedule</h1>
            </div>
            <p class="text-secondary mb-0 small" style="color: #CBD5E1 !important;">Browse workout sessions, monitor live occupancy meters, and manage athlete rosters.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn-power-primary">
                <i class="bi bi-plus-lg me-2"></i>
                Schedule Session
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                var percent = session.Capacity > 0 ? Math.Min(100, (int)Math.Round((double)session.BookedSlots / session.Capacity * 100)) : 0;

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="power-card power-card-interactive h-100 d-flex flex-column overflow-hidden">
                        <!-- Card Header -->
                        <div class="p-4 border-bottom border-subtle bg-surface-2 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small font-mono d-block mb-1" style="color: #94A3B8 !important;">Session #@session.Id</span>
                                <h3 class="h4 mb-0 fw-bold font-display text-white text-uppercase">@session.CategoryName</h3>
                            </div>

                            @if (session.Status == SessionStatus.Upcoming)
                            {
                                <span class="power-badge-upcoming">
                                    <span class="power-pip power-pip-info"></span>
                                    Upcoming
                                </span>
                            }
                            else if (session.Status == SessionStatus.Ongoing)
                            {
                                <span class="power-badge-active">
                                    <span class="power-pip power-pip-success"></span>
                                    Ongoing
                                </span>
                            }
                            else
                            {
                                <span class="power-badge-expired">
                                    <span class="power-pip power-pip-expired"></span>
                                    Completed
                                </span>
                            }
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 flex-grow-1 d-flex flex-column">
                            <p class="text-secondary small mb-4 text-truncate" title="@session.Description" style="color: #CBD5E1 !important;">
                                @session.Description
                            </p>

                            <!-- Session Metrics -->
                            <div class="d-flex flex-column gap-2 mb-4 font-mono small flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-surface-2 border border-subtle">
                                    <span class="text-secondary d-inline-flex align-items-center gap-2" style="color: #CBD5E1 !important;">
                                        <i class="bi bi-person-fill text-power-accent"></i>
                                        Coach
                                    </span>
                                    <strong class="text-white">@session.TrainerName</strong>
                                </div>

                                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-surface-2 border border-subtle">
                                    <span class="text-secondary d-inline-flex align-items-center gap-2" style="color: #CBD5E1 !important;">
                                        <i class="bi bi-calendar-event text-power-accent"></i>
                                        Date
                                    </span>
                                    <strong class="text-white">@session.StartDate.ToString("MMM dd, yyyy")</strong>
                                </div>

                                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-surface-2 border border-subtle">
                                    <span class="text-secondary" style="color: #CBD5E1 !important;">Window / Duration</span>
                                    <strong class="text-white">@session.TimeString (@session.DurationString)</strong>
                                </div>
                            </div>

                            <!-- Capacity Meter -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-secondary font-display text-uppercase small" style="color: #CBD5E1 !important;">Roster Capacity</span>
                                    <span class="font-mono text-power-accent fw-bold small">@session.CapacityString (@percent%)</span>
                                </div>
                                <div class="power-progress">
                                    <div class="power-progress-bar" style="width: @percent%;"></div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="d-flex gap-2 pt-3 border-top border-subtle align-items-center">
                                <a asp-action="Details" asp-route-id="@session.Id" class="btn-power-outline flex-grow-1 justify-content-center py-2 px-3 small text-white">
                                    <i class="bi bi-people-fill me-1 text-power-accent"></i>
                                    Roster
                                </a>

                                @if (session.Status == SessionStatus.Upcoming)
                                {
                                    <a asp-action="Edit" asp-route-id="@session.Id" class="btn-action-edit" title="Edit Session">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                }
                                else
                                {
                                    <button class="btn-action-edit" disabled title="Only upcoming sessions can be modified" style="opacity: 0.3; cursor: not-allowed;">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                }

                                @if (session.Status != SessionStatus.Ongoing)
                                {
                                    <a asp-action="Delete" asp-route-id="@session.Id" class="btn-action-delete" title="Cancel & Delete Session">
                                        <i class="bi bi-trash3-fill"></i>
                                    </a>
                                }
                                else
                                {
                                    <button class="btn-action-delete" disabled title="Ongoing sessions cannot be deleted" style="opacity: 0.3; cursor: not-allowed;">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="power-card text-center py-5 px-4 my-4">
            <div class="d-inline-flex p-4 rounded-circle bg-surface-2 mb-3 border border-subtle">
                <i class="bi bi-calendar-x text-secondary display-4 opacity-50"></i>
            </div>
            <h3 class="font-display fw-bold text-white text-uppercase">No Sessions Scheduled</h3>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 440px; color: #CBD5E1 !important;">No workout sessions currently scheduled. Add your first training slot to open member bookings.</p>
            <a asp-action="Create" class="btn-power-primary">
                <i class="bi bi-plus-lg me-2"></i>
                Schedule First Session
            </a>
        </div>
    }
</div>
