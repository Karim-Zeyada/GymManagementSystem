@model SessionDetailsViewModel

@{
    ViewData["Title"] = "Session Details";

    var headerBg = Model.Status switch
    {
        SessionStatus.Upcoming => "background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);",
        SessionStatus.Ongoing => "background: linear-gradient(135deg, #065f46 0%, #10b981 100%);",
        SessionStatus.Completed => "background: linear-gradient(135deg, #4b5563 0%, #9ca3af 100%);",
        _ => "background: #6c757d;"
    };

    var badgeText = Model.Status switch
    {
        SessionStatus.Upcoming => "🔵 Upcoming",
        SessionStatus.Ongoing => "🟢 Ongoing",
        SessionStatus.Completed => "⚪ Completed",
        _ => "Status"
    };
}

<div class="row justify-content-center my-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <!-- Header with Status Colour -->
            <div class="card-header text-white p-4 d-flex justify-content-between align-items-center" style="@headerBg">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-white bg-opacity-20 p-3">
                        <i class="bi bi-calendar-check-fill fs-3 text-white"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-white">@Model.CategoryName Session</h3>
                        <span class="small text-white-50">Session ID #@Model.Id</span>
                    </div>
                </div>
                <span class="badge bg-light text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                    @badgeText
                </span>
            </div>

            <div class="card-body p-4">
                <div class="row g-3">
                    <!-- Category -->
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-tag-fill text-info me-1"></i>Category
                            </span>
                            <strong class="fs-5 text-dark">@Model.CategoryName</strong>
                        </div>
                    </div>

                    <!-- Trainer -->
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-person-fill text-warning me-1"></i>Assigned Trainer
                            </span>
                            <strong class="fs-5 text-dark">@Model.TrainerName</strong>
                        </div>
                    </div>

                    <!-- Capacity -->
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-people-fill text-success me-1"></i>Capacity (Booked / Max)
                            </span>
                            <strong class="fs-5 text-dark">@Model.CapacityString</strong>
                        </div>
                    </div>

                    <!-- Duration -->
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-stopwatch-fill text-purple me-1"></i>Computed Duration
                            </span>
                            <strong class="fs-5 text-dark">@Model.DurationString</strong>
                        </div>
                    </div>

                    <!-- Start Time -->
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-clock-fill text-primary me-1"></i>Start Time
                            </span>
                            <strong class="text-dark">@Model.StartDate.ToString("f")</strong>
                        </div>
                    </div>

                    <!-- End Time -->
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-clock-history text-secondary me-1"></i>End Time
                            </span>
                            <strong class="text-dark">@Model.EndDate.ToString("f")</strong>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-light border">
                            <span class="text-muted small d-block mb-1">
                                <i class="bi bi-file-text-fill text-primary me-1"></i>Description
                            </span>
                            <p class="mb-0 text-dark">@Model.Description</p>
                        </div>
                    </div>
                </div>

                <!-- Footer with Back Button -->
                <div class="d-flex justify-content-between align-items-center pt-4 mt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>

                    @if (Model.Status == SessionStatus.Upcoming)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                            <i class="bi bi-pencil me-1"></i> Edit Session
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
