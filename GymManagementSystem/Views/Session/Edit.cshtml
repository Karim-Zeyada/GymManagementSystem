@model EditSessionViewModel

@{
    ViewData["Title"] = $"Edit Session #{Model.Id}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="power-card overflow-hidden">
                <!-- Header -->
                <div class="p-4 p-md-5 border-bottom border-subtle">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-surface-2 border border-subtle text-power-accent d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-pencil fs-4"></i>
                        </div>
                        <div>
                            <h1 class="h2 mb-1 fw-bold font-display text-white text-uppercase">Edit Session Schedule</h1>
                            <p class="text-secondary mb-0 small">Adjust session timing, description, and coach assignment for session #@Model.Id.</p>
                        </div>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CategoryId" />
                        <input type="hidden" asp-for="CategoryName" />
                        <input type="hidden" asp-for="Capacity" />

                        <div asp-validation-summary="ModelOnly" class="power-alert-danger p-3 mb-4" role="alert"></div>

                        <!-- Locked Attributes Notice -->
                        <div class="power-stat-box mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="power-badge-secondary small">Locked Contract Attributes</span>
                                <small class="text-secondary fst-italic">Category & Capacity locked to protect existing bookings.</small>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-secondary d-block font-display text-uppercase">Discipline Category</small>
                                    <strong class="fs-6 text-white font-display text-uppercase">@Model.CategoryName</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-secondary d-block font-display text-uppercase">Max Capacity</small>
                                    <strong class="fs-6 text-white font-mono">@Model.Capacity Athletes</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Editable Fields -->
                        <h5 class="font-display fw-bold text-uppercase text-white mb-3 pt-2 border-top border-subtle">Editable Details</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="TrainerId" class="form-label">Assigned Coach <span class="text-power-accent">*</span></label>
                                <select asp-for="TrainerId" asp-items="@(ViewBag.Trainers ?? Model.Trainers)" class="form-select">
                                    <option value="">-- Select Coach --</option>
                                </select>
                                <span asp-validation-for="TrainerId" class="text-danger small"></span>
                                <small class="text-secondary d-block mt-1">Coach specialty must align with: <strong class="text-white">@Model.CategoryName</strong>.</small>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Session Description <span class="text-power-accent">*</span></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="StartDate" class="form-label">Start Date & Time <span class="text-power-accent">*</span></label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control font-mono" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="EndDate" class="form-label">End Date & Time <span class="text-power-accent">*</span></label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control font-mono" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-4 border-top border-subtle">
                            <a asp-action="Index" class="btn-power-ghost">Cancel</a>
                            <button type="submit" class="btn-power-primary">
                                <i class="bi bi-check-lg me-2"></i>
                                Save Schedule Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
